{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "strategy": "SessionLiquidityStack",
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "max_open_trades": 4,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.95,
    "dry_run": true,
    "dry_run_wallet": 10000,
    "fiat_display_currency": "USD",
    "timeframe": "5m",
    "fee": 0.0005,
    "cancel_open_orders_on_exit": false,
    "unfilledtimeout": {"entry": 2, "exit": 2, "exit_timeout_count": 0, "unit": "minutes"},
    "entry_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
    "exit_pricing": {"price_side": "other", "use_order_book": true, "order_book_top": 1},
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT:USDT", "ETH/USDT:USDT", "SOL/USDT:USDT", "BNB/USDT:USDT", "XRP/USDT:USDT",
            "DOGE/USDT:USDT", "ADA/USDT:USDT", "AVAX/USDT:USDT", "LINK/USDT:USDT", "LTC/USDT:USDT",
            "DOT/USDT:USDT", "BCH/USDT:USDT", "TRX/USDT:USDT", "NEAR/USDT:USDT", "ATOM/USDT:USDT",
            "FIL/USDT:USDT", "ETC/USDT:USDT", "UNI/USDT:USDT", "AAVE/USDT:USDT", "XLM/USDT:USDT"
        ],
        "pair_blacklist": []
    },
    "pairlists": [{"method": "StaticPairList"}],
    "sls_modules": ["asia_sweep", "pd_sweep", "ny_orb"],
    "sls_params": {},
    "sls_risk_per_trade": 0.005,
    "bot_name": "sls-futures",
    "initial_state": "running",
    "force_entry_enable": false,
    "internals": {"process_throttle_secs": 5}
}
